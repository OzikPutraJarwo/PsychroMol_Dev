          "relative_humidity_percent": 50,
          "pressure_kpa": null
        },
        "error_fields": [
          "temperature"
        ]
      }
    },
    {
      "name": "text that is not a number is an error",
      "document": {
        "temperature": "n/a",
        "humidity": 50
      },
      "mapping": {
        "time": null,
        "temperature": "/temperature",
        "humidity": "/humidity",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:06.500Z",
          "temperature_c": null,
          "relative_humidity_percent": 50,
          "pressure_kpa": null
        },
        "error_fields": [
          "temperature"
        ]
      }
    },
    {
      "name": "a true or false value is not a number",
      "document": {
        "temperature": true,
        "humidity": 50
      },
      "mapping": {
        "time": null,
        "temperature": "/temperature",
        "humidity": "/humidity",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:06.500Z",
          "temperature_c": null,
