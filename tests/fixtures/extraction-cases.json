          "relative_humidity_percent": null,
          "pressure_kpa": null
        },
        "error_fields": [
          "humidity"
        ]
      }
    },
    {
      "name": "an unreadable time is an error",
      "document": {
        "timestamp": "yesterday",
        "temperature": 21,
        "humidity": 50
      },
      "mapping": {
        "time": "/timestamp",
        "temperature": "/temperature",
        "humidity": "/humidity",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": null,
          "temperature_c": 21,
          "relative_humidity_percent": 50,
          "pressure_kpa": null
        },
        "error_fields": [
          "time"
        ]
      }
    },
    {
      "name": "an impossible calendar date is an error",
      "document": {
        "timestamp": "2026-02-30T00:00:00Z",
        "temperature": 21,
        "humidity": 50
      },
      "mapping": {
        "time": "/timestamp",
        "temperature": "/temperature",
        "humidity": "/humidity",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
