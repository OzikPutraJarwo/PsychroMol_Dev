{
  "about": "Shared by tests/js/fields.test.mjs and tests/test_fetcher.py: the browser preview and the server fetcher must read the same values from the same JSON.",
  "cases": [
    {
      "name": "flat object with an ISO time in UTC",
      "document": {
        "timestamp": "2026-09-17T09:10:04Z",
        "temperature": 27,
        "humidity": 44.6
      },
      "mapping": {
        "time": "/timestamp",
        "temperature": "/temperature",
        "humidity": "/humidity",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:04.000Z",
          "temperature_c": 27,
          "relative_humidity_percent": 44.6,
          "pressure_kpa": null
        },
        "error_fields": []
      }
    },
    {
      "name": "nested objects, an array index and epoch milliseconds",
      "document": {
        "device": {
          "id": "gh-1"
        },
        "feeds": [
          {
            "created": 1789636204123,
            "sensors": {
              "air": {
                "t": "24.5",
                "rh": "81,2 %"
              }
            }
          }
        ]
      },
      "mapping": {
        "time": "/feeds/0/created",
        "temperature": "/feeds/0/sensors/air/t",
        "humidity": "/feeds/0/sensors/air/rh",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:04.123Z",
          "temperature_c": 24.5,
          "relative_humidity_percent": 81.2,
          "pressure_kpa": null
        },
        "error_fields": []
      }
    },
    {
      "name": "epoch seconds written as text",
      "document": {
        "ts": "1789636204",
        "temp": 25,
        "hum": 70
      },
      "mapping": {
        "time": "/ts",
        "temperature": "/temp",
        "humidity": "/hum",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:04.000Z",
          "temperature_c": 25,
          "relative_humidity_percent": 70,
          "pressure_kpa": null
        },
        "error_fields": []
      }
    },
    {
      "name": "no time field uses the time the reading was received",
      "document": {
        "temp": 25,
        "hum": 70
      },
      "mapping": {
        "time": null,
        "temperature": "/temp",
        "humidity": "/hum",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:06.500Z",
          "temperature_c": 25,
          "relative_humidity_percent": 70,
          "pressure_kpa": null
        },
        "error_fields": []
      }
    },
    {
      "name": "a time without a zone is read as UTC",
      "document": {
        "time": "2026-09-17 16:10:04",
        "temp": 25,
        "hum": 70
      },
      "mapping": {
        "time": "/time",
        "temperature": "/temp",
        "humidity": "/hum",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T16:10:04.000Z",
          "temperature_c": 25,
          "relative_humidity_percent": 70,
          "pressure_kpa": null
        },
        "error_fields": []
      }
    },
    {
      "name": "a time with an offset converts to UTC",
      "document": {
        "time": "2026-09-17T16:10:04.5+07:00",
        "temp": 25,
        "hum": 70
      },
      "mapping": {
        "time": "/time",
        "temperature": "/temp",
        "humidity": "/hum",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:04.500Z",
          "temperature_c": 25,
          "relative_humidity_percent": 70,
          "pressure_kpa": null
        },
        "error_fields": []
      }
    },
    {
      "name": "fractional seconds are cut to milliseconds",
      "document": {
        "time": "2026-09-17T09:10:04.123987Z",
        "temp": 25,
        "hum": 70
      },
      "mapping": {
        "time": "/time",
        "temperature": "/temp",
        "humidity": "/hum",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:04.123Z",
          "temperature_c": 25,
          "relative_humidity_percent": 70,
          "pressure_kpa": null
        },
        "error_fields": []
      }
    },
    {
      "name": "a pressure in hPa becomes kPa",
      "document": {
        "time": "2026-09-17T09:10:04Z",
        "temperature": 20,
        "humidity": 50,
        "baro": 1013.25
      },
      "mapping": {
        "time": "/time",
        "temperature": "/temperature",
        "humidity": "/humidity",
        "pressure": "/baro",
        "pressure_unit": "hPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:04.000Z",
          "temperature_c": 20,
          "relative_humidity_percent": 50,
          "pressure_kpa": 101.325
        },
        "error_fields": []
      }
    },
    {
      "name": "a pressure in Pa becomes kPa",
      "document": {
        "temperature": 20,
        "humidity": 50,
        "pressure": "101325"
      },
      "mapping": {
        "time": null,
        "temperature": "/temperature",
        "humidity": "/humidity",
        "pressure": "/pressure",
        "pressure_unit": "Pa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:06.500Z",
          "temperature_c": 20,
          "relative_humidity_percent": 50,
          "pressure_kpa": 101.325
        },
        "error_fields": []
      }
    },
    {
      "name": "a missing temperature is an error",
      "document": {
        "humidity": 50
      },
      "mapping": {
        "time": null,
        "temperature": "/temp",
        "humidity": "/humidity",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:06.500Z",
