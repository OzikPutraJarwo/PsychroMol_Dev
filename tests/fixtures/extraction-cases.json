          "pressure_kpa": null
        },
        "error_fields": [
          "temperature"
        ]
      }
    },
    {
      "name": "a JSON null is not a number",
      "document": {
        "temperature": 21,
        "humidity": null
      },
      "mapping": {
        "time": null,
        "temperature": "/temperature",
        "humidity": "/humidity",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:06.500Z",
