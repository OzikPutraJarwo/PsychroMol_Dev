        "reading": {
          "measured_at": null,
          "temperature_c": 21,
          "relative_humidity_percent": 50,
          "pressure_kpa": null
        },
        "error_fields": [
          "time"
        ]
      }
    },
    {
      "name": "keys containing a slash or a tilde use JSON Pointer escapes",
      "document": {
        "a/b": {
          "m~n": 21.5
        },
        "h": 60
      },
      "mapping": {
        "time": null,
        "temperature": "/a~1b/m~0n",
        "humidity": "/h",
        "pressure": null,
        "pressure_unit": "kPa"
      },
      "received_at": "2026-09-17T09:10:06.500Z",
      "expected": {
        "reading": {
          "measured_at": "2026-09-17T09:10:06.500Z",
          "temperature_c": 21.5,
          "relative_humidity_percent": 60,
          "pressure_kpa": null
        },
        "error_fields": []
      }
    },
    {
      "name": "an array at the top level",
      "document": [
        {
          "t": 22,
          "h": 55
        }
      ],
      "mapping": {
        "time": null,
        "temperature": "/0/t",
