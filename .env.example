PSYCHROMOL_HOST=127.0.0.1
PSYCHROMOL_PORT=8888
PSYCHROMOL_DATABASE_URL=sqlite:///data/psychromol.db
PSYCHROMOL_LOG_LEVEL=INFO
# PSYCHROMOL_LOG_FILE=logs/psychromol.log
# PSYCHROMOL_CORS_ORIGINS=http://localhost:8888,http://127.0.0.1:8888

# Raspberry Pi: serve the API to other devices on the network.
# PSYCHROMOL_HOST=0.0.0.0
# PSYCHROMOL_CORS_ORIGINS=http://192.168.1.50:8888,http://localhost:5173

# Raspberry Pi: read the SHT10/soil/light sensors and drive the fan, pump
# and stepper wired to the GPIO header. See README's Raspberry Pi section.
# PSYCHROMOL_HARDWARE_ENABLED=true
# PSYCHROMOL_HARDWARE_PROFILE_ID=1
# PSYCHROMOL_HARDWARE_POLL_SECONDS=5
# PSYCHROMOL_PIN_SHT10_SCK=23
# PSYCHROMOL_PIN_SHT10_DATA=24
# PSYCHROMOL_PIN_FAN_PIN=17
# PSYCHROMOL_PIN_PUMP_PIN=27
# PSYCHROMOL_PIN_STEPPER_IN1=5
# PSYCHROMOL_PIN_STEPPER_IN2=6
# PSYCHROMOL_PIN_STEPPER_IN3=13
# PSYCHROMOL_PIN_STEPPER_IN4=19
# PSYCHROMOL_PIN_OLED_ADDRESS=60
